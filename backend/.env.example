# Salin file ini menjadi .env lalu sesuaikan
DATABASE_URL=postgres://postgres:PASSWORDMU@localhost:5432/kavling
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter
COOKIE_SECURE=false
APP_URL=http://localhost:3000

# Akun admin pertama (dibuat otomatis kalau tabel users masih kosong)
ADMIN_EMAIL=admin@kavling.local
ADMIN_PASSWORD=Admin12345

# Email untuk reset password. Boleh dikosongkan saat development:
# link reset akan dicetak di terminal backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
